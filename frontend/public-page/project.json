{
  "name": "public-page",
  "sourceRoot": "frontend/public-page",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/public-page",
        "commands": [
          "npx eslint \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"i18n/**/*.{ts,tsx}\"",
          "prettier --config ../../.prettierrc --check \"app/**/*.{ts,tsx,json}\" \"lib/**/*.{ts,tsx,json}\" \"messages/*.json\" \"i18n/**/*.{ts,tsx}\""
        ],
        "parallel": false,
        "forwardAllArgs": false
      }
    }
  },
  "tags": ["type:app", "scope:frontend"]
}
