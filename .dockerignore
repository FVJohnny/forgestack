# Ignore everything
**

# Allow frontend/public-page source files
!frontend/public-page/**

# Ignore build artifacts and dependencies in frontend/public-page
frontend/public-page/node_modules/**
frontend/public-page/.next/**
frontend/public-page/.env*
frontend/public-page/*.tsbuildinfo
frontend/public-page/.pnpm-store/**
frontend/public-page/.vercel/**

# Allow backend files for NestJS service builds
!backend/libs/**
!backend/services/**
!package*.json
!nx.json
!tsconfig*.json

# Allow infra files for monitoring images. Do NOT whitelist infra/env/** as
# a whole: the *.env.prod files hold real secrets and one stray COPY would
# bake them into a pushed image. The public-page env file is the only one a
# Dockerfile needs (build-time NEXT_PUBLIC_* values).
!infra/caddy/**
!infra/monitoring/**
!infra/env/public-page.env.prod
!infra/env/public-page.env.prod.example

# Runtime secret, mounted by compose; never part of a build context.
infra/monitoring/prometheus/internal-api-key

# Ignore build artifacts and dependencies in backend
backend/**/node_modules/**
backend/**/dist/**
backend/**/.env*
backend/**/*.tsbuildinfo
