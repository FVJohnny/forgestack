# Unified Caddyfile for dev and prod
# Dev sets TLS_ENV=dev (self-signed certs), prod sets TLS_ENV=prod (Let's Encrypt)

(tls-dev) {
	tls internal
}

(tls-prod) {
}

# Basic auth for admin surfaces (Portainer). Enforced in prod, open in dev.
# Prod requires CADDY_BASIC_AUTH_HASH (see infra/env/infra.env.prod.example);
# Caddy refuses to start if it is missing, which is intentional: Portainer has
# root-equivalent Docker socket access and must never be public without auth.
(admin-auth-dev) {
}

(admin-auth-prod) {
	basic_auth {
		{$CADDY_BASIC_AUTH_USER:admin} {$CADDY_BASIC_AUTH_HASH}
	}
}

# Response compression plus baseline security headers. Imported by the public
# app and API hosts. Grafana and Portainer set their own headers, so they do
# not import this to avoid duplicating/overriding them.
(common) {
	encode zstd gzip
	header {
		# Do not advertise the server software.
		-Server
		# Only send Referer to same-origin, and never over a downgrade.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Block MIME sniffing.
		X-Content-Type-Options "nosniff"
		# Framing (X-Frame-Options) and HSTS are owned by the apps themselves
		# (Next's headers() on the frontend, helmet on the API): Caddy's
		# `header` would silently OVERWRITE their values with a conflicting
		# copy (it replaced the frontend's DENY with SAMEORIGIN).
	}
}

{$PROTOCOL:http}://www.{$DOMAIN:localhost} {
	import tls-{$TLS_ENV:dev}
	redir {$PROTOCOL:http}://{$DOMAIN:localhost}{uri} permanent
}

{$PROTOCOL:http}://{$DOMAIN:localhost} {
	import tls-{$TLS_ENV:dev}
	import common

	# Same-origin API routing. The backend services are served under path
	# prefixes on the SAME origin as the frontend, so the browser's auth cookies
	# are first-party (host-only, SameSite=Lax) and just work. A separate
	# service<N>.$DOMAIN host would be cross-site to the frontend, which forces
	# SameSite=None cookies; those are rejected outright in dev because
	# `Domain=.localhost` is an invalid cookie domain in every browser.
	#
	# handle_path strips the matched prefix before proxying, so each service
	# still serves its own /api/v1/* internally. Each service gets its own
	# prefix, and the service generator adds one per new service using this
	# rule: a service named service-<N> is served at /svc<N> (service-3 ->
	# /svc3); any other name at /svc<name without dashes> (billing ->
	# /svcbilling). Set the same prefix as PROXY_BASE_PATH in the service's env
	# so its Swagger UI resolves behind the proxy.
	handle_path /svc1/* {
		reverse_proxy service-1:3000
	}

	handle_path /svc2/* {
		reverse_proxy service-2:3000
	}

	# Everything else is the Next.js frontend.
	handle {
		reverse_proxy public-page:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				max_conns_per_host 0
				keepalive 90s
				keepalive_idle_conns 32
			}
		}
	}
}

{$PROTOCOL:http}://grafana.{$DOMAIN:localhost} {
	import tls-{$TLS_ENV:dev}
	reverse_proxy grafana:3000
}

{$PROTOCOL:http}://portainer.{$DOMAIN:localhost} {
	import tls-{$TLS_ENV:dev}
	import admin-auth-{$TLS_ENV:dev}
	reverse_proxy portainer:9000
}

# Dev-only sites (DB viewers, …). The dev compose mounts infra/caddy/dev-only
# here; the prod image ships an empty placeholder, so these hosts simply don't
# exist in prod.
import /etc/caddy/extra/*.caddy
