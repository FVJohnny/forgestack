# =============================================================================
# Public Page (Frontend) Production Environment Variables
# Copy this file to public-page.env.prod and fill in the values
#
# NOTE: NEXT_PUBLIC_* variables are baked into the build at build time.
# Other variables are available at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration (build-time)
# -----------------------------------------------------------------------------
# The services are served under path prefixes on the same origin as the site
# (Caddy strips /svc1 and /svc2), so the auth cookies are first-party.
NEXT_PUBLIC_API_URL=https://example.com/svc1/api/v1
NEXT_PUBLIC_SERVICE2_API_URL=https://example.com/svc2/api/v1

# Base for OpenGraph/canonical URLs, robots.txt, and sitemap.xml. Set this to
# the public site host, otherwise those default to https://localhost in the
# built bundle.
NEXT_PUBLIC_SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# Google OAuth (build-time)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
