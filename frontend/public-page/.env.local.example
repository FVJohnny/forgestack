# =============================================================================
# Public Page (Frontend) Development Environment Variables
# =============================================================================

# API Configuration (build-time). The services are served under path prefixes
# on the SAME origin as the frontend (Caddy strips /svc1 and /svc2), so the
# browser's auth cookies are first-party and just work.
NEXT_PUBLIC_API_URL=https://localhost/svc1/api/v1

# Google OAuth (build-time) - optional for dev
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Service-2 API (build-time) - analytics demo endpoint
NEXT_PUBLIC_SERVICE2_API_URL=https://localhost/svc2/api/v1

# Site URL (build-time) - base for OpenGraph/canonical URLs, robots.txt, and
# sitemap.xml. Defaults to https://localhost when unset.
NEXT_PUBLIC_SITE_URL=https://localhost
