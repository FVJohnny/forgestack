{
  "name": "forgestack-tools",
  "sourceRoot": "tools/forgestack/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "jestConfig": "tools/forgestack/jest.config.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "tools/forgestack/src/**/*.js",
          "eslint/rules/**/*.mjs"
        ]
      }
    }
  },
  "tags": [
    "type:tooling"
  ]
}
