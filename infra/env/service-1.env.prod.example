# =============================================================================
# Service-1 Production Environment Variables
# Copy this file to service-1.env.prod and fill in the values
# =============================================================================

NODE_ENV=production
# Swagger UI + OpenAPI spec are OFF in production by default (they expose the
# full API surface). Uncomment to force on; only do this behind auth.
# SWAGGER_ENABLED=true
PORT=3000
# The path prefix Caddy serves this service under (handle_path /svc1/* strips
# it before proxying). Swagger uses it so the docs UI, its spec URL and
# "Try it out" resolve to /svc1/... instead of the frontend at the origin root.
PROXY_BASE_PATH=/svc1
SERVICE_NAME=service-1

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
KAFKA_SERVICE_ID=service-1
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Set KAFKA_SSL=true for TLS without SASL creds (TLS is auto-enabled when creds are set).
KAFKA_SSL=false

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# Prod mongod runs with --auth. The user and password must match
# MONGO_ADMIN_USER / MONGO_ADMIN_PASS in infra.env.prod, and authSource=admin
# is required because the user lives in the admin database.
MONGODB_URI=mongodb://admin:your-mongo-password@mongodb:27017/app?replicaSet=rs0&authSource=admin

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0
REDIS_TLS=false

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=YOUR_JWT_SECRET_CHANGE_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_CHANGE_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# First admin user
# -----------------------------------------------------------------------------
# Prod seeds the first admin only if both are set and no users exist; uncomment for the first deploy.
# DEFAULT_USER_EMAIL=admin@example.com
# DEFAULT_USER_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Internal API Key (for /health, /metrics endpoints). Must be the same real
# secret in every service; deploy.sh refuses placeholders and mismatches and
# writes it into Prometheus's scrape key file on the server.
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://example.com,https://www.example.com
FRONTEND_URL=https://example.com

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# The backend verifies the Google access token against Google's tokeninfo /
# userinfo endpoints (see google-oauth.service.ts); it does not do a
# server-side authorization-code exchange, so no client secret is used.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# -----------------------------------------------------------------------------
# SMTP Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_APP_PASSWORD

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
