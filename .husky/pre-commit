#!/bin/sh
# POSIX sh (husky runs hooks with `sh -e`, which may be dash on Linux — no
# bashisms like ${PIPESTATUS[0]} or echo "\n").

# 1. Lint + format ONLY the staged files, and re-stage exactly what was fixed.
#    lint-staged handles the add itself, so we never `git add` the whole tree.
echo "Running lint-staged on staged files..."
npx --no-install lint-staged || {
  printf '\n%s\n' "lint-staged failed. Fix the issues before committing."
  exit 1
}

# 2. Typecheck. There is no per-project Nx typecheck target yet (see the
#    backlog), so this runs the workspace script; it is cached by Nx underneath.
echo "Typechecking..."
npm run -s typecheck || {
  printf '\n%s\n' "Typecheck failed. Fix the errors before committing."
  exit 1
}

# 3. Test only the projects affected by the staged changes.
echo "Testing affected projects..."
npx nx affected -t test --base=HEAD || {
  printf '\n%s\n' "Tests failed. Fix the failures before committing."
  exit 1
}

printf '%s\n' "All pre-commit checks passed."
