{
  "name": "forgestack-web",
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locales.mjs",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"i18n/**/*.{ts,tsx}\" && prettier --config ../../.prettierrc --check \"app/**/*.{ts,tsx,json}\" \"lib/**/*.{ts,tsx,json}\" \"messages/*.json\" \"i18n/**/*.{ts,tsx}\"",
    "lint:fix": "prettier --config ../../.prettierrc --write \"app/**/*.{ts,tsx,json}\" \"lib/**/*.{ts,tsx,json}\" \"messages/*.json\" \"i18n/**/*.{ts,tsx}\"",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@react-oauth/google": "^0.13.4",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "16.1.0",
    "next-intl": "^4.1.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.10",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
